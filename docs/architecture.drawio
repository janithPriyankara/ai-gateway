<mxfile host="app.diagrams.net"><diagram id="arch" name="Architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n11" value="&lt;b style=&#x27;font-size:20px&#x27;&gt;mcp-gateway: architecture&lt;/b&gt;&lt;br&gt;One login per AI tool. One login per MCP server. Every call authenticated, authorized, credential-injected and audited." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="50" as="geometry"/></mxCell><mxCell id="n12" value="AI clients" style="text;html=1;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="170" height="24" as="geometry"/></mxCell><mxCell id="n13" value="Claude Code&lt;br&gt;&lt;i&gt;OAuth 2.1 + PKCE&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="170" height="50" as="geometry"/></mxCell><mxCell id="n14" value="Claude Desktop / claude.ai&lt;br&gt;&lt;i&gt;remote connector&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="175" width="170" height="50" as="geometry"/></mxCell><mxCell id="n15" value="Codex CLI&lt;br&gt;&lt;i&gt;static gw_ token&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="170" height="50" as="geometry"/></mxCell><mxCell id="n16" value="Cursor / VS Code / others&lt;br&gt;&lt;i&gt;Streamable HTTP&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="305" width="170" height="50" as="geometry"/></mxCell><mxCell id="n17" value="Admin browser&lt;br&gt;&lt;i&gt;dashboard, passkey login&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="170" height="50" as="geometry"/></mxCell><mxCell id="n18" value="TLS edge: Caddy / Cloudflare Tunnel / Tailscale (optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;horizontal=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="40" height="410" as="geometry"/></mxCell><mxCell id="n19" value="mcp-gateway: one Go binary (gw serve --services=all) or 4 containers (microservices mode)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#333333;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=15;fontStyle=1;arcSize=3;" vertex="1" parent="1"><mxGeometry x="330" y="80" width="900" height="690" as="geometry"/></mxCell><mxCell id="n20" value="Data plane: gateway service (stateless, horizontally scalable)  POST /mcp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="350" y="120" width="860" height="230" as="geometry"/></mxCell><mxCell id="n21" value="1. AuthN middleware&lt;br&gt;verify JWT (JWKS cache) or&lt;br&gt;static token → Identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="160" width="150" height="70" as="geometry"/></mxCell><mxCell id="n22" value="2. Policy engine&lt;br&gt;first-match rules&lt;br&gt;allow / ask / deny + rate limit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="160" width="150" height="70" as="geometry"/></mxCell><mxCell id="n23" value="3. Router / aggregator&lt;br&gt;namespaced tools&lt;br&gt;github__create_issue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="160" width="150" height="70" as="geometry"/></mxCell><mxCell id="n24" value="4. Tool-pin check&lt;br&gt;sha256(name+desc+schema)&lt;br&gt;quarantine on drift" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="160" width="150" height="70" as="geometry"/></mxCell><mxCell id="n25" value="5. Credential injector&lt;br&gt;per-user upstream token&lt;br&gt;(never client token)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="160" width="145" height="70" as="geometry"/></mxCell><mxCell id="n26" value="Upstream pool&lt;br&gt;HTTP (Streamable) + stdio (sandboxed)&lt;br&gt;circuit breaker, timeouts, read-only retry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="255" width="320" height="70" as="geometry"/></mxCell><mxCell id="n27" value="6. Redactor + audit emitter&lt;br&gt;scrub secrets, async batch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="255" width="320" height="70" as="geometry"/></mxCell><mxCell id="n28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n21" target="n22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n22" target="n23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n23" target="n24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n24" target="n25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="n25" target="n26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n33" value="Control plane" style="text;html=1;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="350" y="365" width="200" height="24" as="geometry"/></mxCell><mxCell id="n34" value="Auth service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="350" y="395" width="270" height="300" as="geometry"/></mxCell><mxCell id="n35" value="OAuth 2.1 authorization server&lt;br&gt;DCR · PKCE S256 · refresh rotation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="365" y="430" width="240" height="44" as="geometry"/></mxCell><mxCell id="n36" value="Protected Resource Metadata&lt;br&gt;/.well-known/* · JWKS (ES256)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="365" y="482" width="240" height="44" as="geometry"/></mxCell><mxCell id="n37" value="Passkeys (WebAuthn) · bootstrap token&lt;br&gt;external OIDC IdP (optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="365" y="534" width="240" height="44" as="geometry"/></mxCell><mxCell id="n38" value="Static client tokens (argon2id hashed)&lt;br&gt;signing-key rotation (90 days)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="365" y="586" width="240" height="44" as="geometry"/></mxCell><mxCell id="n39" value="auth.db" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="640" width="70" height="45" as="geometry"/></mxCell><mxCell id="n40" value="Vault service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="640" y="395" width="270" height="300" as="geometry"/></mxCell><mxCell id="n41" value="Envelope encryption&lt;br&gt;AES-256-GCM DEK per secret" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="655" y="430" width="240" height="44" as="geometry"/></mxCell><mxCell id="n42" value="Upstream OAuth connect&lt;br&gt;(auth code + PKCE as a client)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="655" y="482" width="240" height="44" as="geometry"/></mxCell><mxCell id="n43" value="Token refresher&lt;br&gt;refresh at 80% TTL · needs_reauth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="655" y="534" width="240" height="44" as="geometry"/></mxCell><mxCell id="n44" value="KeyProvider port&lt;br&gt;wrap / unwrap / health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="655" y="586" width="240" height="44" as="geometry"/></mxCell><mxCell id="n45" value="vault.db" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="640" width="70" height="45" as="geometry"/></mxCell><mxCell id="n46" value="Control service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="930" y="395" width="280" height="300" as="geometry"/></mxCell><mxCell id="n47" value="Admin REST API /admin/api/v1&lt;br&gt;OpenAPI · SSE live events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="945" y="430" width="250" height="44" as="geometry"/></mxCell><mxCell id="n48" value="Dashboard SPA (React, embedded)&lt;br&gt;RBAC: owner / admin / member / viewer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="945" y="482" width="250" height="44" as="geometry"/></mxCell><mxCell id="n49" value="Servers · profiles · rules · catalog&lt;br&gt;config snapshot (versioned) → gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="945" y="534" width="250" height="44" as="geometry"/></mxCell><mxCell id="n50" value="Approvals broker · tool pins&lt;br&gt;audit log (hash chain)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="945" y="586" width="250" height="44" as="geometry"/></mxCell><mxCell id="n51" value="control.db" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1035" y="640" width="80" height="45" as="geometry"/></mxCell><mxCell id="n52" value="&lt;b&gt;Ports and adapters:&lt;/b&gt; the gateway depends only on interfaces (Authenticator, ConfigSource, CredentialProvider, AuditSink, ApprovalBroker). Monolith mode wires in-process adapters; microservices mode wires internal HTTP clients (service token + mTLS-ready). Database per service: SQLite (WAL)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="702" width="860" height="60" as="geometry"/></mxCell><mxCell id="n53" value="MCP servers (upstream)" style="text;html=1;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1290" y="80" width="220" height="24" as="geometry"/></mxCell><mxCell id="n54" value="GitHub MCP&lt;br&gt;&lt;i&gt;OAuth&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1290" y="110" width="220" height="46" as="geometry"/></mxCell><mxCell id="n55" value="Notion MCP&lt;br&gt;&lt;i&gt;OAuth&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1290" y="166" width="220" height="46" as="geometry"/></mxCell><mxCell id="n56" value="Slack MCP&lt;br&gt;&lt;i&gt;OAuth&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1290" y="222" width="220" height="46" as="geometry"/></mxCell><mxCell id="n57" value="Jenkins MCP&lt;br&gt;&lt;i&gt;API key header&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1290" y="278" width="220" height="46" as="geometry"/></mxCell><mxCell id="n58" value="Postgres / filesystem&lt;br&gt;&lt;i&gt;local stdio, sandboxed child&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1290" y="334" width="220" height="46" as="geometry"/></mxCell><mxCell id="n59" value="Upstream OAuth servers&lt;br&gt;(github.com, notion.so …)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1290" y="470" width="220" height="50" as="geometry"/></mxCell><mxCell id="n60" value="KeyProvider plugins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="850" width="590" height="110" as="geometry"/></mxCell><mxCell id="n61" value="macOS Keychain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="655" y="885" width="100" height="40" as="geometry"/></mxCell><mxCell id="n62" value="Windows DPAPI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="885" width="100" height="40" as="geometry"/></mxCell><mxCell id="n63" value="Linux TPM2&lt;br&gt;systemd-creds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="885" y="885" width="100" height="40" as="geometry"/></mxCell><mxCell id="n64" value="Docker / K8s secret" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="885" width="100" height="40" as="geometry"/></mxCell><mxCell id="n65" value="Passphrase&lt;br&gt;argon2id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1115" y="885" width="100" height="40" as="geometry"/></mxCell><mxCell id="n66" value="+ AWS KMS · GCP KMS · Azure Key Vault · Vault/OpenBao Transit" style="text;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="655" y="932" width="560" height="20" as="geometry"/></mxCell><mxCell id="n67" value="Notifier plugins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1290" y="600" width="220" height="160" as="geometry"/></mxCell><mxCell id="n68" value="OS notification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1305" y="630" width="190" height="26" as="geometry"/></mxCell><mxCell id="n69" value="Web push / dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1305" y="662" width="190" height="26" as="geometry"/></mxCell><mxCell id="n70" value="ntfy · Telegram" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1305" y="694" width="190" height="26" as="geometry"/></mxCell><mxCell id="n71" value="Slack · email" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1305" y="726" width="190" height="26" as="geometry"/></mxCell><mxCell id="n72" value="&lt;b&gt;Deployment modes&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Personal:&lt;/b&gt; gw serve on 127.0.0.1 (launchd / systemd / Windows service)&lt;br&gt;• &lt;b&gt;Home lab / VPS:&lt;/b&gt; docker compose up (all-in-one container)&lt;br&gt;• &lt;b&gt;Microservices:&lt;/b&gt; docker compose -f deploy/compose.split.yml up&lt;br&gt;&amp;nbsp;&amp;nbsp;gateway ×N (stateless) + auth + vault + control" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacing